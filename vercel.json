{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/", "dest": "/landing.html" },
    { "src": "/landing", "dest": "/landing.html" },
    { "src": "/login", "dest": "/login.html" },
    { "src": "/daftar", "dest": "/daftar.html" },
    { "src": "/dashboard", "dest": "/dashboard.html" }
  ]
}
