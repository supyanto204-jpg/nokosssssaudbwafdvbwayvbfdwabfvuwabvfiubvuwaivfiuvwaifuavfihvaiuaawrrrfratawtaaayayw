{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "redirects": [
    { "source": "/", "destination": "/landing", "permanent": false },
    { "source": "/public/landing.html", "destination": "/landing", "permanent": true },
    { "source": "/public/login.html", "destination": "/login", "permanent": true },
    { "source": "/public/daftar.html", "destination": "/daftar", "permanent": true },
    { "source": "/public/dashboard.html", "destination": "/dashboard", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/landing", "destination": "/public/landing.html" },
    { "source": "/login", "destination": "/public/login.html" },
    { "source": "/daftar", "destination": "/public/daftar.html" },
    { "source": "/dashboard", "destination": "/public/dashboard.html" }
  ]
}
