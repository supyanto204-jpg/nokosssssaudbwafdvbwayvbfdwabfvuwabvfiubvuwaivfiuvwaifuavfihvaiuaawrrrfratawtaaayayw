{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "maxDuration": 30 } },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "redirects": [
    { "source": "/", "destination": "/landing", "permanent": false },
    { "source": "/landing.html", "destination": "/landing", "permanent": true },
    { "source": "/login.html", "destination": "/login", "permanent": true },
    { "source": "/daftar.html", "destination": "/daftar", "permanent": true },
    { "source": "/dashboard.html", "destination": "/dashboard", "permanent": true },
    { "source": "/profile.html", "destination": "/profile", "permanent": true },
    { "source": "/nokos.html", "destination": "/nokos", "permanent": true },
    { "source": "/deposit.html", "destination": "/deposit", "permanent": true },
    { "source": "/inbox.html", "destination": "/inbox", "permanent": true },
    { "source": "/ketentuan.html", "destination": "/ketentuan", "permanent": true },
    { "source": "/syarat.html", "destination": "/syarat", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/landing", "destination": "/public/landing.html" },
    { "source": "/login", "destination": "/public/login.html" },
    { "source": "/daftar", "destination": "/public/daftar.html" },
    { "source": "/dashboard", "destination": "/public/dashboard.html" },
    { "source": "/profile", "destination": "/public/profile.html" },
    { "source": "/nokos", "destination": "/public/nokos.html" },
    { "source": "/deposit", "destination": "/public/deposit.html" },
    { "source": "/inbox", "destination": "/public/inbox.html" },
    { "source": "/ketentuan", "destination": "/public/ketentuan.html" },
    { "source": "/syarat", "destination": "/public/syarat.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
